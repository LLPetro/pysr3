date-released: "2026-05-25"
repository-code: "https://github.com/LLPetro/pysr3"
url: "https://llpetro.github.io/pysr3/"
keywords:
  - CMG
  - SR3
  - reservoir simulation
  - grid
  - PyVista
  - visualization
